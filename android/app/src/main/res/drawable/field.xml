<?xml version="1.0" encoding="utf-8"?>
<!-- Text boxes: the surface colour with a light-blue outline when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/surface"/><stroke android:width="1.5dp" android:color="@color/accent"/><corners android:radius="14dp"/></shape></item>
    <item><shape><solid android:color="@color/surface"/><stroke android:width="1dp" android:color="@color/line"/><corners android:radius="14dp"/></shape></item>
</selector>
