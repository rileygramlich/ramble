<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Yap" android:textSize="44sp" android:textStyle="bold" android:textColor="@color/accent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Talk instead of typing. Your voice never leaves the phone."
            android:textSize="16sp" android:textColor="@color/ink_soft" android:paddingBottom="20dp" />

        <TextView android:id="@+id/ready" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/ink" android:paddingBottom="8dp" />
        <Button android:id="@+id/step_mic" style="@style/Step" />
        <Button android:id="@+id/step_bubble" style="@style/Step" />
        <TextView style="@style/Note"
            android:text="If Android says the setting is restricted: open Yap's App info, tap ⋮, choose “Allow restricted settings”, then try step 2 again." />

        <TextView style="@style/Heading" android:text="Or use the Yap keyboard" />
        <Button android:id="@+id/step_enable" style="@style/Step" />
        <Button android:id="@+id/step_switch" style="@style/Step" />

        <EditText android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minLines="3" android:gravity="top" android:hint="Try it here"
            android:textColor="@color/ink" android:textColorHint="@color/ink_soft"
            android:layout_marginTop="16dp" android:inputType="textMultiLine|textCapSentences" />

        <TextView style="@style/Heading" android:text="Speech on Art" />
        <TextView style="@style/Note"
            android:text="When your phone can reach Art over Tailscale, Yap sends what you say there: a much bigger speech model plus the smarter tidy-up. It never goes anywhere else. Away from home, the phone does it all itself. Clear the address to always stay on the phone." />
        <EditText android:id="@+id/speech_url" style="@style/Field"
            android:hint="Blank = phone only" android:inputType="textUri" />

        <TextView style="@style/Heading" android:text="Tidy-up away from Art (optional)" />
        <TextView style="@style/Note"
            android:text="The phone always removes ums and stutters, and handles “scratch that” and “new line”. For smarter tidy-up when Art is off, point it at another Ollama server." />
        <EditText android:id="@+id/ollama_url" style="@style/Field"
            android:hint="Blank = phone's rules" android:inputType="textUri" />
        <EditText android:id="@+id/ollama_model" style="@style/Field"
            android:hint="qwen2.5:1.5b" android:inputType="text" />

        <TextView style="@style/Heading" android:text="Words to get right" />
        <TextView style="@style/Note" android:text="Names and jargon, separated by commas." />
        <EditText android:id="@+id/vocabulary" style="@style/Field"
            android:hint="Tommy Games, Quiddler, Katharina" android:inputType="textMultiLine" />
    </LinearLayout>
</ScrollView>
