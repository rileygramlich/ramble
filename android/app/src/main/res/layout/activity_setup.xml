<?xml version="1.0" encoding="utf-8"?>
<!-- Yap's main screen: a line on whether it's ready, a box to try it in, and your history. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="yap" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="-0.02"
                android:textColor="@color/accent" />
            <ImageButton android:id="@+id/open_settings"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_settings" android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings" />
        </LinearLayout>

        <TextView android:id="@+id/ready" style="@style/Note"
            android:paddingTop="2dp" android:paddingBottom="16dp" />

        <LinearLayout android:id="@+id/setup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="12dp">
            <Button android:id="@+id/step_mic" style="@style/Step" />
            <Button android:id="@+id/step_bubble" style="@style/Step" />
            <TextView style="@style/Note" android:paddingTop="8dp"
                android:text="If Android says the setting is restricted: open Yap's App info, tap ⋮, choose “Allow restricted settings”, then try again." />
        </LinearLayout>

        <EditText android:id="@+id/try_it" style="@style/Field"
            android:minLines="2" android:gravity="top" android:singleLine="false"
            android:hint="Try it here" android:inputType="textMultiLine|textCapSentences" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="28dp" android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                style="@style/Label" android:text="History" />
            <TextView android:id="@+id/clear_history" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Clear" android:textColor="@color/ink_soft" android:textSize="14sp"
                android:padding="8dp" android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <LinearLayout android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView android:id="@+id/history_empty" style="@style/Note"
            android:gravity="center" android:paddingVertical="32dp"
            android:text="What you say shows up here: your last 100 dictations, kept only on this phone. Tap one to copy it." />
    </LinearLayout>
</ScrollView>
