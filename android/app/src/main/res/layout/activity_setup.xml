<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Yap" android:textSize="44sp" android:textStyle="bold" android:textColor="@color/accent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Talk instead of typing. Your voice never leaves the phone."
            android:textSize="16sp" android:textColor="@color/ink_soft" android:paddingBottom="20dp" />

        <TextView android:id="@+id/ready" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/ink" android:paddingBottom="8dp" />
        <Button android:id="@+id/step_mic" style="@style/Step" />
        <Button android:id="@+id/step_enable" style="@style/Step" />
        <Button android:id="@+id/step_switch" style="@style/Step" />

        <EditText android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minLines="3" android:gravity="top" android:hint="Try it here"
            android:textColor="@color/ink" android:textColorHint="@color/ink_soft"
            android:layout_marginTop="16dp" android:inputType="textMultiLine|textCapSentences" />

        <TextView style="@style/Heading" android:text="Tidy-up (optional)" />
        <TextView style="@style/Note"
            android:text="Yap always removes ums, stutters, and handles “scratch that” and “new line” on the phone. For smarter tidy-up, point it at your own Ollama server over Tailscale. Leave blank to skip." />
        <EditText android:id="@+id/ollama_url" style="@style/Field"
            android:hint="http://100.75.130.34:11434" android:inputType="textUri" />
        <EditText android:id="@+id/ollama_model" style="@style/Field"
            android:hint="qwen2.5:1.5b" android:inputType="text" />

        <TextView style="@style/Heading" android:text="Words to get right" />
        <TextView style="@style/Note" android:text="Names and jargon, separated by commas." />
        <EditText android:id="@+id/vocabulary" style="@style/Field"
            android:hint="Tommy Games, Quiddler, Katharina" android:inputType="textMultiLine" />
    </LinearLayout>
</ScrollView>
