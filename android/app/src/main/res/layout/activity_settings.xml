<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the steps to turn Ramble on, plus where speech and tidy-up happen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="←" android:textSize="22sp" android:textColor="@color/ink"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Settings" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" />
        </LinearLayout>

        <TextView style="@style/Heading" android:text="The bubble" />
        <TextView style="@style/Note" android:text="A small mic that sits just above your keyboard, whichever keyboard you use." />
        <Button android:id="@+id/step_mic" style="@style/Step" />
        <Button android:id="@+id/step_bubble" style="@style/Step" />
        <TextView style="@style/Note" android:paddingTop="8dp"
            android:text="If Android says the setting is restricted: open Ramble's App info, tap ⋮, choose “Allow restricted settings”, then try again." />

        <TextView style="@style/Heading" android:text="Or the Ramble keyboard" />
        <Button android:id="@+id/step_enable" style="@style/Step" />
        <Button android:id="@+id/step_switch" style="@style/Step" />

        <TextView style="@style/Heading" android:text="Speech on your computer (optional)" />
        <TextView style="@style/Note"
            android:text="Run `ramble serve` on a computer (the desktop app) and the phone sends what you say there instead: a much bigger speech model plus the smarter tidy-up. Both need to be on the same Tailscale network; put the computer\'s address below, like http://100.x.y.z:8723. Away from it, or with this blank, the phone does it all itself." />
        <EditText android:id="@+id/speech_url" style="@style/Field"
            android:hint="Blank = everything on the phone" android:inputType="textUri" />

        <TextView style="@style/Heading" android:text="Tidy-up without the computer" />
        <TextView style="@style/Note"
            android:text="Optional. The phone always removes ums and stutters, and handles “scratch that” and “new line”. For smarter tidy-up when Art is off, point it at another Ollama server." />
        <EditText android:id="@+id/ollama_url" style="@style/Field"
            android:hint="Blank = phone's rules" android:inputType="textUri" />
        <EditText android:id="@+id/ollama_model" style="@style/Field"
            android:hint="qwen2.5:1.5b" android:inputType="text" />

        <TextView style="@style/Heading" android:text="Dictionary" />
        <TextView style="@style/Note"
            android:text="Names and words to spell right. To fix a word it keeps mishearing, or for your own shortcuts and emoji, fill in what to type instead: say “orthodox cross emoji”, type ☦️." />
        <LinearLayout android:id="@+id/dictionary_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" />
        <EditText android:id="@+id/dictionary_say" style="@style/Field"
            android:hint="Word, or what you say" android:inputType="text" android:imeOptions="actionNext" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
            <EditText android:id="@+id/dictionary_type" style="@style/Field"
                android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="0dp"
                android:hint="Type instead (optional)" android:inputType="text" android:imeOptions="actionDone" />
            <Button android:id="@+id/dictionary_add" style="@style/Step"
                android:layout_width="wrap_content" android:layout_height="52dp"
                android:layout_marginStart="10dp" android:layout_marginTop="0dp"
                android:minHeight="0dp" android:minWidth="76dp" android:gravity="center"
                android:text="Add" android:contentDescription="Add to the dictionary" />
        </LinearLayout>

        <TextView style="@style/Heading" android:text="Spoken punctuation" />
        <Switch android:id="@+id/spoken_punctuation" style="@style/Note"
            android:layout_marginTop="6dp" android:minHeight="48dp" android:textSize="16sp"
            android:textColor="@color/ink" android:text="Turn “period”, “comma” and “question mark” into symbols" />
        <TextView style="@style/Note"
            android:text="“Haha” ends without a period unless you say one: “haha period” types “Haha.”. “A period of time” stays as words. Emoji work too, switch or not: “laughing emoji” 😂, “heart emoji” ❤️, “thumbs up emoji” 👍, “fire emoji” 🔥." />

        <TextView style="@style/Heading" android:text="Diagnostics" />
        <TextView style="@style/Note"
            android:text="What the bubble did with your last dictations: which box it found, how it typed, and whether the text stuck. It never stores what you said. If something goes wrong, tap Copy report and include it in a GitHub issue." />
        <TextView android:id="@+id/diag_info" style="@style/Note" android:paddingTop="10dp" android:textIsSelectable="true" />
        <TextView android:id="@+id/diag_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:padding="14dp"
            android:background="@drawable/card" android:textColor="@color/ink_soft"
            android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true"
            android:lineSpacingMultiplier="1.2" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="4dp">
            <Button android:id="@+id/diag_copy" style="@style/Step" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginEnd="8dp" android:gravity="center" android:text="Copy report" />
            <Button android:id="@+id/diag_clear" style="@style/Step" android:layout_width="0dp" android:layout_weight="1"
                android:gravity="center" android:text="Clear" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
