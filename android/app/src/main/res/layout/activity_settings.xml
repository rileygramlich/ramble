<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the steps to turn Yap on, plus where speech and tidy-up happen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="←" android:textSize="22sp" android:textColor="@color/ink"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Settings" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" />
        </LinearLayout>

        <TextView style="@style/Heading" android:text="The bubble" />
        <TextView style="@style/Note" android:text="A small mic that sits just above your keyboard, whichever keyboard you use." />
        <Button android:id="@+id/step_mic" style="@style/Step" />
        <Button android:id="@+id/step_bubble" style="@style/Step" />
        <TextView style="@style/Note" android:paddingTop="8dp"
            android:text="If Android says the setting is restricted: open Yap's App info, tap ⋮, choose “Allow restricted settings”, then try again." />

        <TextView style="@style/Heading" android:text="Or the Yap keyboard" />
        <Button android:id="@+id/step_enable" style="@style/Step" />
        <Button android:id="@+id/step_switch" style="@style/Step" />

        <TextView style="@style/Heading" android:text="Speech on Art" />
        <TextView style="@style/Note"
            android:text="When your phone can reach Art over Tailscale, Yap sends what you say there: a much bigger speech model plus the smarter tidy-up. It never goes anywhere else. Away from home, the phone does it all itself. Clear the address to always stay on the phone." />
        <EditText android:id="@+id/speech_url" style="@style/Field"
            android:hint="Blank = phone only" android:inputType="textUri" />

        <TextView style="@style/Heading" android:text="Tidy-up away from Art" />
        <TextView style="@style/Note"
            android:text="Optional. The phone always removes ums and stutters, and handles “scratch that” and “new line”. For smarter tidy-up when Art is off, point it at another Ollama server." />
        <EditText android:id="@+id/ollama_url" style="@style/Field"
            android:hint="Blank = phone's rules" android:inputType="textUri" />
        <EditText android:id="@+id/ollama_model" style="@style/Field"
            android:hint="qwen2.5:1.5b" android:inputType="text" />

        <TextView style="@style/Heading" android:text="Words to get right" />
        <TextView style="@style/Note" android:text="Names and jargon, separated by commas." />
        <EditText android:id="@+id/vocabulary" style="@style/Field" android:singleLine="false"
            android:hint="Tommy Games, Quiddler, Katharina" android:inputType="textMultiLine" />
    </LinearLayout>
</ScrollView>
