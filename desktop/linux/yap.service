# Start Yap at login. Install with:
#   ln -s "$PWD/linux/yap.service" ~/.config/systemd/user/ && systemctl --user enable --now yap
[Unit]
Description=Yap dictation
PartOf=graphical-session.target
After=graphical-session.target ydotool.service ollama.service

[Service]
WorkingDirectory=%h/dev/yap/desktop
ExecStart=%h/.local/bin/uv run --frozen yap
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
